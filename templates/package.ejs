{
  "name": "<%= projectName %>",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --exec tsx ./src/index.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": { <% const dependencies = Object.entries(allDependencies.latestDependencies);
    dependencies.forEach(([name, version], index) => { %> 
    "<%= name %>": "<%= version %>"<%= index < dependencies.length - 1 ? "," : "" %> <% }); %>  
  },
  "devDependencies": { <% const devDependencies = Object.entries(allDependencies.latestDevDependencies);
    devDependencies.forEach(([name, version], index) => { %>
    "<%= name %>": "<%= version %>"<%= index < devDependencies.length - 1 ? "," : "" %> <% }); %>
  }
}
